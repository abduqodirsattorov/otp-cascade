{
    "name": "otp-cascade/laravel-otp-cascade",
    "description": "Biometric Passkey (FIDO2) and In-App Push OTP cascade authentication package for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OTP Cascade Team"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0",
        "web-auth/webauthn-framework": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OtpCascade\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OtpCascade\\Laravel\\OtpCascadeServiceProvider"
            ]
        }
    }
}
